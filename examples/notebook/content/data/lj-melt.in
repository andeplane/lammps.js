# A small Lennard-Jones melt — fetched and run by basics/02-scripts-and-files.
units         lj
atom_style    atomic
lattice       fcc 0.8442
region        box block 0 2 0 2 0 2
create_box    1 box
create_atoms  1 box
mass          1 1.0
velocity      all create 3.0 87287
pair_style    lj/cut 2.5
pair_coeff    1 1 1.0 1.0 2.5
fix           1 all nve
thermo        100
run           300
