diff --git a/src/error.cpp b/src/error.cpp
index 7d7f7e4..bda2e18 100644
--- a/src/error.cpp
+++ b/src/error.cpp
@@ -19,8 +19,21 @@
 #include "universe.h"
 #include "update.h"
 
+#include <algorithm>
+
 using namespace LAMMPS_NS;
 
+// lammps.js: C++20 builds (KOKKOS forces C++20) make the bundled fmt format
+// fixed-size char arrays (e.g. ReaxFF's char name[4]) at full length, so
+// "X" arrives as "X\0\0". fputs() then truncates the message, dropping the
+// "(file:line)" suffix and the newline (see LAMMPS-patches.md).
+static std::string vformat_nonul(fmt::string_view format, fmt::format_args args)
+{
+  std::string mesg = fmt::vformat(format, args);
+  mesg.erase(std::remove(mesg.begin(), mesg.end(), '\0'), mesg.end());
+  return mesg;
+}
+
 // helper function to truncate a string to a segment starting with "src/";
 
 static std::string truncpath(const std::string &path)
@@ -198,7 +211,7 @@ void Error::_all(const std::string &file, int line, int failed, fmt::string_view
                  fmt::format_args args)
 {
   try {
-    all(file, line, failed, fmt::vformat(format, args));
+    all(file, line, failed, vformat_nonul(format, args));
   } catch (fmt::format_error &e) {
     all(file, line, NOPOINTER, e.what());
   }
@@ -209,7 +222,7 @@ void Error::_one(const std::string &file, int line, int failed, fmt::string_view
                  fmt::format_args args)
 {
   try {
-    one(file, line, failed, fmt::vformat(format, args));
+    one(file, line, failed, vformat_nonul(format, args));
   } catch (fmt::format_error &e) {
     one(file, line, NOPOINTER, e.what());
   }
@@ -238,7 +251,7 @@ void Error::_warning(const std::string &file, int line, fmt::string_view format,
                      fmt::format_args args)
 {
   try {
-    warning(file,line,fmt::vformat(format, args));
+    warning(file,line,vformat_nonul(format, args));
   } catch (fmt::format_error &e) {
     warning(file,line,e.what());
   }
